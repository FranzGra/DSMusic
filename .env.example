# Copia questo file in .env e inserisci i valori presi dal Discord Developer Portal.
# Non condividere mai il file .env: contiene segreti.

# Applicazione Discord (General Information / OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot → Reset Token
DISCORD_BOT_TOKEN=

# Porta locale del server (API, WebSocket e interfaccia)
PORT=3001

# Facoltativo: canali musica, uno o più ID separati da virgola. Lì ogni messaggio è un link,
# una ricerca o una parola comando (skip, salta, pausa, riprendi, stop, coda).
# In tutti gli altri canali il bot risponde solo se lo menzioni (@bot titolo).
# Richiede l'intent privilegiato "Message Content" (Bot → Privileged Gateway Intents).
MUSIC_TEXT_CHANNEL_ID=

# ---------- Uscita automatica dal canale vocale ----------
# Secondi di attesa quando nel canale del bot non resta nessuno (i bot non contano):
# la musica va subito in pausa, poi il bot esce. La coda resta. 0 = disattivato. Predefinito 60.
USCITA_CANALE_VUOTO_SECONDI=60
# Minuti senza niente in riproduzione (coda finita) prima che il bot esca. 0 = disattivato. Predefinito 5.
USCITA_INATTIVITA_MINUTI=5
# Chi parla nel canale (anello sull'avatar): il bot entra senza «deaf» e guarda solo chi manda voce,
# senza ascoltarla né decodificarla. 0 = spento (il bot torna self-deaf). Predefinito 1.
MOSTRA_CHI_PARLA=1
# Stato del canale vocale (il testo sotto il nome del canale): «🎵 Titolo — Autore» del brano in corso,
# aggiornato a ogni brano; all'uscita torna lo stato di prima (o vuoto). Serve il permesso
# «Imposta stato del canale vocale». 0 = spento. Predefinito 1.
STATO_CANALE=1

# ---------- Modalità prova (interfaccia nel browser, senza Discord) ----------
# 1 = avvia anche senza credenziali: il bot non si collega, la GUI funziona su http://localhost:3001
MODALITA_PROVA=0
# Server e canale usati dalla GUI fuori da Discord. Con un bot vero possono essere ID reali
# (tasto destro → Copia ID, con la Modalità sviluppatore di Discord attiva).
PROVA_GUILD_ID=prova-server
PROVA_CHANNEL_ID=prova-canale

# Facoltativo: percorsi di yt-dlp e ffmpeg se non sono nel PATH
# YTDLP_PATH=
# FFMPEG_PATH=

# ---------- Stabilità ----------
# Cartella dove si salva la coda (sopravvive ai riavvii). Predefinito ./data; in Docker è il volume /app/data.
# DATA_DIR=data
# Secondi senza audio (yt-dlp o ffmpeg bloccati) prima di passare al brano dopo. Predefinito 30.
# BLOCCO_AUDIO_SECONDI=30

# ---------- Leggerezza (macchine con poca RAM) ----------
# Cache audio in RAM (mai su disco): per ogni server restano in memoria l'ultimo brano ascoltato,
# quello in corso e i 2 prossimi (~1 MB per minuto); gli altri escono subito. Partenza, spostamento,
# cambio di volume e «precedente» senza rete.
# MB massimi, unici per tutti i server (0 = spenta). Predefinito 96.
# CACHE_AUDIO_MB=96
# Brani massimi in cache per server (un valore più basso ne tiene meno). Predefinito 4.
# CACHE_AUDIO_BRANI=4
# Brani più lunghi di così (minuti) e dirette non vanno in cache. Predefinito 20.
# CACHE_AUDIO_MAX_MINUTI=20
# Minuti senza il bot in nessun canale vocale prima di liberare cache, link e memoria. 0 = mai. Predefinito 2.
# RIPOSO_MINUTI=2
# Processi yt-dlp nello stesso momento (ognuno ~265 MB per 3 s). 1 = più leggero, ricerche in fila. Predefinito 2.
# YTDLP_CONTEMPORANEI=2

# ---------- Soundbar (suoni brevi caricati dall'Activity) ----------
# Ruoli Discord che possono caricare suoni: ID separati da virgola (tasto destro sul ruolo → Copia ID).
# Vuoto = solo gli amministratori. Suonare: tutti; rinominare/eliminare: chi l'ha caricato o un admin.
# In Docker docker-compose.yml lo legge da qui (oppure da docker-compose.override.yml).
# SOUNDBAR_RUOLO_ID=
# Durata massima di un suono in secondi (tolleranza 0,25 s). Predefinito 20.
# SOUNDBAR_MAX_SECONDI=20
# Dimensione massima del file caricato in MB. Predefinito 2.
# SOUNDBAR_MAX_MB=2
# Facoltativo: percorso di ffprobe (durata dei suoni) se non è accanto a ffmpeg o nel PATH
# FFPROBE_PATH=
